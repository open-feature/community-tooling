{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "labels": [
    "renovate"
  ],
  "git-submodules": {
    "enabled": true
  },
  "dependencyDashboardApproval": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "vulnerability-updates",
    "dependencyDashboardApproval": false,
    "semanticCommitType": "fix",
    "semanticCommitScope": "security",
    "commitMessageSuffix": "[SECURITY]"
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Auto-create PRs for OpenFeature own artifacts",
      "matchSourceUrls": ["https://github.com/open-feature/**"],
      "dependencyDashboardApproval": false,
      "packageRules": [
        {
          "description": "Schedule major updates for Fridays",
          "matchUpdateTypes": ["major"],
          "schedule": ["on friday"]
        }
      ]
    },
    {
      "dependencyDashboardCategory": "Major {{categories}} updates",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Automerge minor updates if they are not 0.x releases",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^0/",
      "dependencyDashboardCategory": "Minor {{categories}} updates",
      "dependencyDashboardFooter": "These updates will auto-merge on ci passing.",
      "automerge": true
    },
    {
      "description": "Automerge patch and digest updates",
      "matchUpdateTypes": ["patch", "digest"],
      "dependencyDashboardCategory": "Patch/digest updates",
      "dependencyDashboardFooter": "These updates will auto-merge on ci passing.",
      "automerge": true
    },
    {
      "description": "Automerge github action updates of all types except releasing ones",
      "matchManagers": ["github-actions"],
      "excludeDepNames": [
        "google-github-actions/release-please-action",
        "googleapis/release-please-action",
        "goreleaser/goreleaser-action"
      ],
      "dependencyDashboardFooter": "These updates will auto-merge on ci passing.",
      "automerge": true
    },
    {
      "description": "Show releasing github action updates in a dedicated category.",
      "matchManagers": ["github-actions"],
      "matchDepNames": [
        "google-github-actions/release-please-action",
        "googleapis/release-please-action",
        "goreleaser/goreleaser-action"
      ],
      "dependencyDashboardCategory": "Releasing updates",
      "dependencyDashboardFooter": ""
    },
    {
      "description": "Automerge submodules",
      "matchManagers": ["git-submodules"],
      "automerge": true
    },
    {
      "description": "Automerge devdependency updates of all types",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    }
  ]
}
