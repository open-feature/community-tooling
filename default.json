{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "labels": [
    "renovate"
  ],
  "git-submodules": {
    "enabled": true
  },
  "dependencyDashboardApproval": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "vulnerability-updates",
    "dependencyDashboardApproval": false,
    "semanticCommitType": "fix",
    "semanticCommitScope": "security",
    "commitMessageSuffix": "[SECURITY]"
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Auto-create PRs for OpenFeature own artifacts",
      "matchSourceUrls": ["https://github.com/open-feature/**"],
      "dependencyDashboardApproval": false,
      "packageRules": [
        {
          "description": "Schedule major updates for Fridays",
          "matchUpdateTypes": ["major"],
          "schedule": ["on friday"]
        }
      ]
    },
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge github action updates of all types",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "Never automerge releasing action updates, even via the generic rules above",
      "matchManagers": ["github-actions"],
      "matchDepNames": [
        "google-github-actions/release-please-action",
        "googleapis/release-please-action",
        "goreleaser/goreleaser-action"
      ],
      "automerge": false
    },
    {
      "description": "Submodule updates cannot be aged: git-refs exposes no release timestamps",
      "matchManagers": ["git-submodules"],
      "minimumReleaseAge": null
    },
    {
      "description": "Submodules track release tags; never chase upstream branch HEAD",
      "matchManagers": ["git-submodules"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Automerge submodule minor and patch updates",
      "matchManagers": ["git-submodules"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Submodule major updates get a PR for review",
      "matchManagers": ["git-submodules"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Registries that do not expose release timestamps cannot be aged",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/**", "gcr.io/**", "quay.io/**"],
      "minimumReleaseAge": null
    },
    {
      "description": "Automerge devdependency updates of all types",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    }
  ]
}
